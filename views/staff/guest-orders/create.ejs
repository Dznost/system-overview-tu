<%- contentFor('body') %>

<section class="staff-create-guest-order">
  <div class="container">
    <div class="page-header">
      <h1>Dat Don Hang Ho Khach Hang</h1>
      <a href="/staff/guest-orders" class="btn btn-secondary btn-sm">Quay Lai</a>
    </div>

    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (branch) { %>
    <div class="branch-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span><%= branch.name %></span>
      <span class="table-info">Ban trong: <strong><%= branch.availableTables %>/<%= branch.totalTables %></strong></span>
    </div>
    <% } %>

    <div class="deposit-notice">
      <strong>Chi phi dat coc: 100,000d</strong> - Khach hang phai coc khi dat ban. Thoi gian dat phai cach hien tai it nhat 2 gio.
    </div>

    <form method="POST" action="/staff/guest-orders/create" id="createOrderForm">
      <div class="form-grid">
        <!-- Guest info -->
        <div class="form-card">
          <h3>Thong Tin Khach Hang</h3>
          <div class="form-row">
            <div class="form-group">
              <label for="guestName">Ho ten khach <span class="required">*</span></label>
              <input type="text" id="guestName" name="guestName" placeholder="Nhap ten khach hang..." class="form-input" required>
            </div>
            <div class="form-group">
              <label for="guestPhone">So dien thoai <span class="required">*</span></label>
              <input type="text" id="guestPhone" name="guestPhone" placeholder="0xxx xxx xxx" class="form-input" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="guestEmail">Email (khong bat buoc)</label>
              <input type="email" id="guestEmail" name="guestEmail" placeholder="email@example.com" class="form-input">
            </div>
          </div>

          <!-- Booking date/time -->
          <h3 style="margin-top: 20px;">Thoi Gian Dat Ban</h3>
          <div class="form-row">
            <div class="form-group">
              <label for="bookingDate">Ngay dat <span class="required">*</span></label>
              <input type="date" id="bookingDate" name="bookingDate" class="form-input" required>
            </div>
            <div class="form-group">
              <label for="bookingTime">Gio dat <span class="required">*</span></label>
              <input type="time" id="bookingTime" name="bookingTime" class="form-input" required>
            </div>
          </div>

          <div class="form-group">
            <label for="specialRequests">Ghi chu</label>
            <textarea id="specialRequests" name="specialRequests" rows="2" placeholder="Yeu cau dac biet..." class="form-input"></textarea>
          </div>

          <div class="payment-info-box">
            <strong>Phuong thuc thanh toan:</strong> Chuyen khoan ngan hang (bat buoc)
            <p style="font-size: 0.85rem; color: #666; margin-top: 4px;">Don dat ban ho khach bat buoc su dung chuyen khoan de dam bao an toan.</p>
          </div>
        </div>

        <!-- Menu selection -->
        <div class="form-card">
          <h3>Chon Mon An</h3>
          <div class="dishes-grid" id="dishesGrid">
            <% if (dishes && dishes.length > 0) { %>
              <% dishes.forEach(dish => { %>
              <div class="dish-card" data-id="<%= dish._id %>" data-name="<%= dish.name %>" data-price="<%= dish.discount > 0 ? dish.price * (1 - dish.discount/100) : dish.price %>">
                <div class="dish-img">
                  <% if (dish.image) { %>
                  <img src="<%= dish.image %>" alt="<%= dish.name %>">
                  <% } else { %>
                  <div class="no-img">No Image</div>
                  <% } %>
                </div>
                <div class="dish-info">
                  <div class="dish-name"><%= dish.name %></div>
                  <div class="dish-price">
                    <% if (dish.discount > 0) { %>
                    <span class="old-price"><%= dish.price.toLocaleString('vi-VN') %>d</span>
                    <span class="new-price"><%= Math.round(dish.price * (1 - dish.discount/100)).toLocaleString('vi-VN') %>d</span>
                    <% } else { %>
                    <span><%= dish.price.toLocaleString('vi-VN') %>d</span>
                    <% } %>
                  </div>
                  <div class="dish-qty">
                    <button type="button" class="qty-btn minus">-</button>
                    <span class="qty-value">0</span>
                    <button type="button" class="qty-btn plus">+</button>
                  </div>
                </div>
              </div>
              <% }) %>
            <% } else { %>
            <p class="no-dishes">Khong co mon an nao</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Order summary -->
      <div class="order-summary">
        <h3>Tong Don Hang</h3>
        <div class="summary-items" id="summaryItems">
          <p class="empty-msg">Chua chon mon nao</p>
        </div>
        <div class="summary-row">
          <span>Tien mon:</span>
          <span id="subtotal">0d</span>
        </div>
        <div class="summary-row deposit">
          <span>Tien coc:</span>
          <span>100,000d</span>
        </div>
        <div class="summary-row total">
          <span>Tong cong:</span>
          <span id="grandTotal">100,000d</span>
        </div>
        <input type="hidden" name="items" id="itemsInput" value="[]">
        <button type="submit" class="btn btn-primary btn-block" id="submitBtn" disabled>Tao Don Dat Ban</button>
      </div>
    </form>
  </div>
</section>

<style>
.staff-create-guest-order { padding: 20px 0; }
.staff-create-guest-order .container { max-width: 1200px; margin: 0 auto; padding: 0 15px; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
.page-header h1 { font-size: 1.5rem; margin: 0; }
.btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; font-size: 0.875rem; text-decoration: none; cursor: pointer; border: none; transition: all 0.2s; }
.btn-primary { background: #2563eb; color: white; }
.btn-primary:hover { background: #1d4ed8; }
.btn-primary:disabled { background: #9ca3af; cursor: not-allowed; }
.btn-secondary { background: #6b7280; color: white; }
.btn-sm { padding: 6px 12px; font-size: 0.8125rem; }
.btn-block { width: 100%; justify-content: center; }
.alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; }
.alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
.branch-tag { display: flex; align-items: center; gap: 8px; padding: 10px 16px; background: #f0fdf4; border: 1px solid #86efac; border-radius: 6px; margin-bottom: 16px; font-size: 0.875rem; color: #166534; }
.branch-tag .table-info { margin-left: auto; }
.deposit-notice { background: #fff3cd; border: 1px solid #ffc107; padding: 12px; border-radius: 6px; margin-bottom: 20px; color: #856404; font-size: 0.875rem; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
@media (max-width: 900px) { .form-grid { grid-template-columns: 1fr; } }
.form-card { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; }
.form-card h3 { font-size: 1rem; margin: 0 0 16px 0; padding-bottom: 10px; border-bottom: 1px solid #e5e7eb; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
@media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }
.form-group { margin-bottom: 12px; }
.form-group label { display: block; font-size: 0.8125rem; font-weight: 500; margin-bottom: 4px; color: #374151; }
.form-group .required { color: #ef4444; }
.form-input { width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.875rem; }
.form-input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 2px rgba(37,99,235,0.1); }
.dishes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; max-height: 400px; overflow-y: auto; }
.dish-card { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background: white; transition: all 0.2s; }
.dish-card.selected { border-color: #2563eb; box-shadow: 0 0 0 2px rgba(37,99,235,0.2); }
.dish-img { height: 80px; background: #f3f4f6; }
.dish-img img { width: 100%; height: 100%; object-fit: cover; }
.dish-img .no-img { height: 100%; display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 0.75rem; }
.dish-info { padding: 10px; }
.dish-name { font-size: 0.8125rem; font-weight: 500; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dish-price { font-size: 0.75rem; color: #059669; margin-bottom: 8px; }
.dish-price .old-price { text-decoration: line-through; color: #9ca3af; margin-right: 4px; }
.dish-price .new-price { color: #dc2626; font-weight: 600; }
.dish-qty { display: flex; align-items: center; justify-content: center; gap: 8px; }
.qty-btn { width: 24px; height: 24px; border: 1px solid #d1d5db; border-radius: 4px; background: white; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; }
.qty-btn:hover { background: #f3f4f6; }
.qty-value { font-size: 0.875rem; font-weight: 600; min-width: 20px; text-align: center; }
.order-summary { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; position: sticky; top: 20px; }
.order-summary h3 { font-size: 1rem; margin: 0 0 16px 0; padding-bottom: 10px; border-bottom: 1px solid #e5e7eb; }
.summary-items { max-height: 150px; overflow-y: auto; margin-bottom: 16px; }
.summary-items .empty-msg { color: #9ca3af; font-size: 0.8125rem; text-align: center; }
.summary-item { display: flex; justify-content: space-between; font-size: 0.8125rem; padding: 4px 0; }
.summary-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 0.875rem; border-top: 1px solid #e5e7eb; }
.summary-row.deposit { color: #f59e0b; }
.summary-row.total { font-weight: 700; font-size: 1rem; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const dishCards = document.querySelectorAll('.dish-card');
  const summaryItems = document.getElementById('summaryItems');
  const subtotalEl = document.getElementById('subtotal');
  const grandTotalEl = document.getElementById('grandTotal');
  const itemsInput = document.getElementById('itemsInput');
  const submitBtn = document.getElementById('submitBtn');
  
  const cart = {};
  const DEPOSIT = 100000;

  // Set min date/time to today + 2 hours
  const now = new Date();
  const minDateTime = new Date(now.getTime() + 2 * 60 * 60 * 1000);
  const dateInput = document.getElementById('bookingDate');
  const timeInput = document.getElementById('bookingTime');
  
  dateInput.min = minDateTime.toISOString().split('T')[0];
  dateInput.value = minDateTime.toISOString().split('T')[0];
  
  // Set default time to 2 hours from now
  const hours = String(minDateTime.getHours()).padStart(2, '0');
  const minutes = String(minDateTime.getMinutes()).padStart(2, '0');
  timeInput.value = `${hours}:${minutes}`;
  
  // Validate on form submit
  document.getElementById('createOrderForm').addEventListener('submit', function(e) {
    const selectedDate = dateInput.value;
    const selectedTime = timeInput.value;
    const selectedDateTime = new Date(`${selectedDate}T${selectedTime}`);
    const twoHoursFromNow = new Date(Date.now() + 2 * 60 * 60 * 1000);
    
    if (selectedDateTime < twoHoursFromNow) {
      e.preventDefault();
      alert('Thoi gian dat ban phai toi thieu 2 tieng tu bay gio!');
      return false;
    }
  });

  dishCards.forEach(card => {
    const id = card.dataset.id;
    const name = card.dataset.name;
    const price = parseFloat(card.dataset.price);
    const qtyDisplay = card.querySelector('.qty-value');
    const minusBtn = card.querySelector('.minus');
    const plusBtn = card.querySelector('.plus');

    plusBtn.addEventListener('click', () => {
      if (!cart[id]) cart[id] = { id, name, price, qty: 0 };
      cart[id].qty++;
      qtyDisplay.textContent = cart[id].qty;
      card.classList.add('selected');
      updateSummary();
    });

    minusBtn.addEventListener('click', () => {
      if (cart[id] && cart[id].qty > 0) {
        cart[id].qty--;
        qtyDisplay.textContent = cart[id].qty;
        if (cart[id].qty === 0) {
          delete cart[id];
          card.classList.remove('selected');
        }
        updateSummary();
      }
    });
  });

  function updateSummary() {
    const items = Object.values(cart).filter(i => i.qty > 0);
    
    if (items.length === 0) {
      summaryItems.innerHTML = '<p class="empty-msg">Chua chon mon nao</p>';
      subtotalEl.textContent = '0d';
      grandTotalEl.textContent = DEPOSIT.toLocaleString('vi-VN') + 'd';
      itemsInput.value = '[]';
      submitBtn.disabled = true;
      return;
    }

    let html = '';
    let subtotal = 0;
    const itemsData = [];

    items.forEach(item => {
      const total = item.price * item.qty;
      subtotal += total;
      html += `<div class="summary-item"><span>${item.name} x${item.qty}</span><span>${total.toLocaleString('vi-VN')}d</span></div>`;
      itemsData.push({ dishId: item.id, quantity: item.qty });
    });

    summaryItems.innerHTML = html;
    subtotalEl.textContent = subtotal.toLocaleString('vi-VN') + 'd';
    grandTotalEl.textContent = (subtotal + DEPOSIT).toLocaleString('vi-VN') + 'd';
    itemsInput.value = JSON.stringify(itemsData);
    submitBtn.disabled = false;
  }
});
</script>
