<!-- Products Page -->
<section class="products-hero-section">
    <div class="products-hero-overlay"></div>
    <div class="products-hero-content">
        <span class="products-hero-subtitle">Kham Pha San Pham</span>
        <h1 class="products-hero-title">San Pham</h1>
        <p class="products-hero-desc">Cac san pham chat luong cao cho nha bep va ban an cua ban</p>
    </div>
</section>

<section class="products-main-section">
    <div class="container">
        <!-- Search and Filter Bar -->
        <div class="products-controls">
            <form method="GET" action="/products" class="products-search-form">
                <div class="search-input-wrapper">
                    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                    </svg>
                    <input type="text" name="search" placeholder="Tim kiem san pham..." value="<%= search || '' %>" class="products-search-input">
                </div>
                <button type="submit" class="btn btn-primary">Tim Kiem</button>
            </form>
        </div>

        <!-- Results Info -->
        <div class="products-results-info">
            <% if (products.length > 0) { %>
                <p class="results-count">Hien thi <strong><%= products.length %></strong> san pham</p>
            <% } %>
        </div>

        <!-- Products Grid -->
        <div class="products-items-grid">
            <% if (products.length === 0) { %>
                <div class="products-empty-state">
                    <div class="empty-icon">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                        </svg>
                    </div>
                    <h3>Khong Tim Thay San Pham</h3>
                    <p>Hay thu tim kiem voi tu khoa khac</p>
                    <a href="/products" class="btn btn-secondary">Xem Tat Ca San Pham</a>
                </div>
            <% } else { %>
                <% products.forEach(product => { %>
                    <article class="product-item-card">
                        <div class="product-item-image">
                            <img src="<%= product.image || 'https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?w=400&h=300&fit=crop' %>" 
                                 alt="<%= product.name %>" 
                                 loading="lazy"
                                 onerror="this.src='https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?w=400&h=300&fit=crop'">
                            <% if (product.discount > 0) { %>
                                <span class="product-discount-tag">-<%= product.discount %>%</span>
                            <% } %>
                            <% if (product.isHot) { %>
                                <span class="product-hot-tag">HOT</span>
                            <% } %>
                            <% if (product.quantity === 0) { %>
                                <span class="product-out-of-stock">Chay Hang</span>
                            <% } %>
                            <div class="product-item-overlay">
                                <a href="/product/<%= product._id %>" class="product-view-btn">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    Xem Chi Tiet
                                </a>
                            </div>
                        </div>
                        <div class="product-item-body">
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px;">
                                <span class="product-item-type">San Pham</span>
                                <span style="background: #fef3c7; color: #92400e; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">
                                    Con: <%= product.quantity || 0 %>
                                </span>
                            </div>
                            <h3 class="product-item-title"><%= product.name %></h3>
                            <p class="product-item-desc"><%= product.description ? product.description.substring(0, 80) + '...' : 'San pham tiem nang' %></p>
                            
                            <div class="product-item-footer">
                                <div class="product-price-group">
                                    <% if (product.discount > 0) { %>
                                        <span class="product-price-original"><%= product.price.toLocaleString('vi-VN') %>d</span>
                                        <span class="product-price-sale"><%= Math.round(product.price * (1 - product.discount/100)).toLocaleString('vi-VN') %>d</span>
                                    <% } else { %>
                                        <span class="product-price"><%= product.price.toLocaleString('vi-VN') %>d</span>
                                    <% } %>
                                </div>

                                <% if (product.quantity > 0) { %>
                                    <form action="/user/cart/add" method="POST" class="product-add-form">
                                        <input type="hidden" name="productId" value="<%= product._id %>">
                                        <input type="hidden" name="quantity" value="1">
                                        <button type="submit" class="product-add-btn" title="Them vao gio hang">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                                            </svg>
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            <% } %>
        </div>

        <% if (!locals.isLoggedIn && products.length > 0) { %>
            <div class="products-login-prompt">
                <div class="login-prompt-content">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                    <div class="login-prompt-text">
                        <h4>Dat San Pham Ngay</h4>
                        <p><a href="/login">Dang nhap</a> hoac <a href="/register">dang ky</a> de them san pham vao gio hang</p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</section>

<style>
/* Products Hero Section */
.products-hero-section {
    position: relative;
    height: 400px;
    background: linear-gradient(135deg, #8B6F47 0%, #6b5438 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    overflow: hidden;
}

.products-hero-overlay {
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?w=1920&h=1080&fit=crop') center/cover;
    opacity: 0.2;
}

.products-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
}

.products-hero-subtitle {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
    opacity: 0.9;
}

.products-hero-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 12px;
}

.products-hero-desc {
    font-size: 1.125rem;
    opacity: 0.9;
    max-width: 600px;
}

/* Products Main Section */
.products-main-section {
    padding: 60px 20px;
    background: white;
}

.products-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 40px;
}

.products-search-form {
    display: flex;
    gap: 12px;
    flex: 1;
}

.search-input-wrapper {
    position: relative;
    flex: 1;
}

.search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #6b7280;
}

.products-search-input {
    width: 100%;
    padding: 12px 16px 12px 40px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.9375rem;
    transition: all 0.3s;
}

.products-search-input:focus {
    outline: none;
    border-color: #8B6F47;
    box-shadow: 0 0 0 3px rgba(139, 111, 71, 0.1);
}

.products-results-info {
    margin-bottom: 30px;
}

.results-count {
    color: #6b7280;
    font-size: 0.9375rem;
}

.products-items-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 60px;
}

.product-item-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    border: 1px solid #f3f4f6;
}

.product-item-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
}

.product-item-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    background: #f9fafb;
}

.product-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.product-item-card:hover .product-item-image img {
    transform: scale(1.08);
}

.product-discount-tag {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #dc2626;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
}

.product-hot-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
}

.product-out-of-stock {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: #dc2626;
    color: white;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.product-item-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
}

.product-item-card:hover .product-item-overlay {
    opacity: 1;
}

.product-view-btn {
    padding: 10px 16px;
    background: white;
    color: #1f2937;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.8125rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transform: translateY(8px);
    transition: all 0.3s;
}

.product-item-card:hover .product-view-btn {
    transform: translateY(0);
}

.product-item-body {
    padding: 12px;
}

.product-item-type {
    font-size: 0.75rem;
    color: #8B6F47;
    font-weight: 600;
}

.product-item-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 6px 0;
}

.product-item-desc {
    font-size: 0.8125rem;
    color: #6b7280;
    margin: 0 0 10px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.product-item-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.product-price-group {
    font-size: 0.9rem;
    color: #1f2937;
    font-weight: 600;
}

.product-price-original {
    text-decoration: line-through;
    color: #999;
    margin-right: 8px;
    font-size: 0.8rem;
}

.product-price-sale {
    color: #dc2626;
    font-weight: 700;
}

.product-price {
    font-weight: 600;
}

.product-add-btn {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    border: none;
    background: linear-gradient(135deg, #8B6F47 0%, #6b5438 100%);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}

.product-add-btn:hover {
    transform: scale(1.1);
}

.products-empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
}

.empty-icon {
    margin: 0 auto 20px;
    color: #d1d5db;
}

.products-empty-state h3 {
    font-size: 1.25rem;
    color: #1f2937;
    margin: 0 0 8px 0;
}

.products-empty-state p {
    color: #6b7280;
    margin: 0 0 20px 0;
}

.products-login-prompt {
    margin-top: 40px;
    padding: 24px;
    background: #f0fdf4;
    border-radius: 8px;
    border: 1px solid #bbf7d0;
}

.login-prompt-content {
    display: flex;
    align-items: center;
    gap: 16px;
    color: #166534;
}

.login-prompt-content svg {
    flex-shrink: 0;
}

.login-prompt-text h4 {
    margin: 0 0 4px 0;
    font-size: 0.9375rem;
    font-weight: 600;
}

.login-prompt-text p {
    margin: 0;
    font-size: 0.875rem;
}

.login-prompt-text a {
    color: #166534;
    font-weight: 600;
    text-decoration: none;
}

/* Responsive */
@media (max-width: 1200px) {
    .products-items-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 768px) {
    .products-hero-title {
        font-size: 2rem;
    }

    .products-controls {
        flex-direction: column;
    }

    .products-search-form {
        flex-direction: column;
    }

    .products-items-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
}

@media (max-width: 480px) {
    .products-hero-title {
        font-size: 1.5rem;
    }

    .products-hero-desc {
        font-size: 0.9375rem;
    }

    .products-items-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }
}
</style>
