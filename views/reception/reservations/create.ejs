<div class="container" style="max-width: 920px; margin: 0 auto; padding: 32px 20px;">

  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
    <div>
      <h1 style="font-size: 1.6rem; color: #1a3c34; margin-bottom: 4px;">Dat Ban Ho Khach</h1>
      <p style="color: #607d8b; font-size: 0.9rem;">Tiep tan dat ban thay mat khach hang. Phi dat coc: <strong>100,000d</strong> | Thoi gian dat phai sau hien tai it nhat 2 tieng.</p>
    </div>
    <a href="/reception/reservations" style="color: #00897b; text-decoration: none; font-size: 0.9rem; font-weight: 600;">← Quay lai danh sach</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div style="padding: 14px 18px; margin-bottom: 20px; background: #fdecea; color: #c62828; border-radius: 8px; border-left: 4px solid #c62828; font-size: 0.9rem;">
    <%= error %>
  </div>
  <% } %>

  <form method="POST" action="/reception/reservations/create-guest" id="guestReservationForm">
    <!-- Customer Info -->
    <div style="background: white; border-radius: 12px; padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 8px rgba(0,105,92,0.08);">
      <h3 style="font-size: 1rem; font-weight: 700; color: #1a3c34; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 2px solid #e0f2f1;">
        Thong Tin Khach Hang
      </h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 6px;">Ho Va Ten Khach *</label>
          <input type="text" name="guestName" required placeholder="Nguyen Van A"
            style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'">
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 6px;">So Dien Thoai *</label>
          <input type="tel" name="guestPhone" required placeholder="0912 345 678"
            style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'">
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 6px;">Email (Tuy Chon)</label>
          <input type="email" name="guestEmail" placeholder="email@example.com"
            style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'">
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 6px;">So Khach *</label>
          <input type="number" name="guests" min="1" max="50" required placeholder="Nhap so luong"
            style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'">
        </div>
      </div>
    </div>

    <!-- Reservation Time -->
    <div style="background: white; border-radius: 12px; padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 8px rgba(0,105,92,0.08);">
      <h3 style="font-size: 1rem; font-weight: 700; color: #1a3c34; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 2px solid #e0f2f1;">
        Thoi Gian Dat Ban
        <span style="font-size: 0.78rem; font-weight: 400; color: #f57c00; margin-left: 10px; background: #fff3e0; padding: 3px 10px; border-radius: 10px;">Phai sau hien tai it nhat 2 tieng</span>
      </h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 6px;">Ngay Dat Ban *</label>
          <input type="date" name="date" id="reservDate" required
            style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'">
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 6px;">Gio Dat Ban *</label>
          <input type="time" name="time" id="reservTime" required
            style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'">
        </div>
      </div>
      <div id="timeWarning" style="display:none; margin-top: 10px; padding: 10px 14px; background: #fdecea; color: #c62828; border-radius: 6px; font-size: 0.85rem;">
        Thoi gian dat ban phai cach hien tai it nhat 2 tieng.
      </div>
    </div>

    <!-- Food Pre-order -->
    <div style="background: white; border-radius: 12px; padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 8px rgba(0,105,92,0.08);">
      <h3 style="font-size: 1rem; font-weight: 700; color: #1a3c34; margin-bottom: 6px; padding-bottom: 10px; border-bottom: 2px solid #e0f2f1;">
        Chon Mon An Truoc (Tuy Chon)
      </h3>
      <p style="font-size: 0.85rem; color: #607d8b; margin-bottom: 18px;">Khach co the goi mon khi den. Neu chon truoc thi gia mon se tinh vao tong hoa don.</p>

      <!-- Search & Category Filter -->
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px;">
        <input type="text" id="dishSearch" placeholder="Tim kiem mon an..." 
          style="flex: 1; min-width: 200px; padding: 9px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.88rem; outline: none;">
        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
          <button type="button" class="cat-btn active-cat" data-cat="all"
            style="padding: 7px 14px; border: 1.5px solid #b2dfdb; background: #00897b; color: white; border-radius: 20px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">Tat ca</button>
          <button type="button" class="cat-btn" data-cat="appetizer"
            style="padding: 7px 14px; border: 1.5px solid #b2dfdb; background: white; color: #555; border-radius: 20px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">Khai vi</button>
          <button type="button" class="cat-btn" data-cat="main"
            style="padding: 7px 14px; border: 1.5px solid #b2dfdb; background: white; color: #555; border-radius: 20px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">Mon chinh</button>
          <button type="button" class="cat-btn" data-cat="dessert"
            style="padding: 7px 14px; border: 1.5px solid #b2dfdb; background: white; color: #555; border-radius: 20px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">Trang miem</button>
          <button type="button" class="cat-btn" data-cat="beverage"
            style="padding: 7px 14px; border: 1.5px solid #b2dfdb; background: white; color: #555; border-radius: 20px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">Do uong</button>
        </div>
      </div>

      <div id="dishGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; max-height: 420px; overflow-y: auto; padding: 4px;">
        <% if (dishes && dishes.length > 0) { %>
          <% dishes.forEach(dish => { %>
          <div class="dish-card" 
               data-id="<%= dish._id %>"
               data-name="<%= dish.name.toLowerCase() %>"
               data-cat="<%= dish.category %>"
               style="background: #f9fffe; border: 1.5px solid #e0f2f1; border-radius: 10px; overflow: hidden; transition: all 0.2s; cursor: pointer;">
            <img src="<%= dish.image %>" alt="<%= dish.name %>" 
              style="width: 100%; height: 110px; object-fit: cover;"
              onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=120&h=110&fit=crop'">
            <div style="padding: 10px 12px;">
              <p style="font-size: 0.85rem; font-weight: 700; color: #1a3c34; margin: 0 0 4px; line-height: 1.3; height: 34px; overflow: hidden;"><%= dish.name %></p>
              <p style="font-size: 0.78rem; color: #00897b; font-weight: 600; margin: 0 0 8px;">
                <% if (dish.discount > 0) { %>
                  <span style="text-decoration: line-through; color: #aaa; font-size: 0.73rem;"><%= dish.price.toLocaleString('vi-VN') %>d</span>
                  <span style="color: #c0392b; margin-left: 4px;"><%= (dish.price * (1 - dish.discount/100)).toLocaleString('vi-VN') %>d</span>
                <% } else { %>
                  <%= dish.price.toLocaleString('vi-VN') %>d
                <% } %>
              </p>
              <div style="display: flex; align-items: center; justify-content: center; gap: 6px;">
                <button type="button" class="qty-minus" data-id="<%= dish._id %>"
                  style="width: 26px; height: 26px; border: 1.5px solid #b2dfdb; background: white; border-radius: 6px; font-size: 15px; font-weight: 700; cursor: pointer; color: #00897b; display: flex; align-items: center; justify-content: center;">-</button>
                <input type="number" 
                  name="dishes[<%= dish._id %>][quantity]"
                  id="qty-<%= dish._id %>"
                  class="qty-input"
                  value="0" min="0" max="50"
                  data-id="<%= dish._id %>"
                  data-name="<%= dish.name %>"
                  data-price="<%= dish.price %>"
                  data-discount="<%= dish.discount || 0 %>"
                  style="width: 40px; height: 26px; text-align: center; border: 1.5px solid #b2dfdb; border-radius: 6px; font-size: 0.85rem; padding: 0;">
                <button type="button" class="qty-plus" data-id="<%= dish._id %>"
                  style="width: 26px; height: 26px; border: 1.5px solid #b2dfdb; background: #e0f2f1; border-radius: 6px; font-size: 15px; font-weight: 700; cursor: pointer; color: #00897b; display: flex; align-items: center; justify-content: center;">+</button>
              </div>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div style="grid-column: 1/-1; text-align: center; padding: 40px; color: #aaa;">
            Chi nhanh nay chua co mon an nao.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Special requests -->
    <div style="background: white; border-radius: 12px; padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 8px rgba(0,105,92,0.08);">
      <h3 style="font-size: 1rem; font-weight: 700; color: #1a3c34; margin-bottom: 14px;">Ghi Chu Them</h3>
      <textarea name="specialRequests" placeholder="Yeu cau dac biet, di ung thuc pham, vi tri ban..." rows="3"
        style="width: 100%; padding: 10px 14px; border: 1.5px solid #b2dfdb; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none; resize: vertical; font-family: inherit;"
        onfocus="this.style.borderColor='#00897b'" onblur="this.style.borderColor='#b2dfdb'"></textarea>
    </div>

    <!-- Order Summary -->
    <div id="orderSummary" style="background: linear-gradient(135deg, #e0f2f1 0%, #f0faf8 100%); border: 2px solid #00897b; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
      <h3 style="font-size: 1rem; font-weight: 700; color: #1a3c34; margin-bottom: 16px;">Tom Tat Don Dat Ban Ho Khach</h3>
      <div id="selectedItems" style="margin-bottom: 12px;"></div>
      <div style="border-top: 1.5px solid #b2dfdb; padding-top: 12px;">
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 6px;">
          <span style="color: #555;">Phi dat coc ban:</span>
          <span style="font-weight: 600; color: #00695c;">100,000d</span>
        </div>
        <div id="foodTotalRow" style="display: none; justify-content: space-between; font-size: 0.9rem; margin-bottom: 6px;">
          <span style="color: #555;">Tong mon an:</span>
          <span id="foodTotalSpan" style="font-weight: 600; color: #333;"></span>
        </div>
        <div id="discountRow" style="display: none; justify-content: space-between; font-size: 0.9rem; margin-bottom: 6px;">
          <span style="color: #27ae60;">Giam gia:</span>
          <span id="discountSpan" style="font-weight: 600; color: #27ae60;"></span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 800; color: #00695c; padding-top: 10px; border-top: 1.5px solid #00897b; margin-top: 8px;">
          <span>Tong Thanh Toan (Du Kien):</span>
          <span id="grandTotal">100,000d</span>
        </div>
      </div>
      <p style="font-size: 0.8rem; color: #607d8b; margin-top: 10px; font-style: italic;">
        * Don dat ban ho khach nay se duoc luu vao he thong voi loai "Dat Ho Khach" va co the thanh toan tai quay.
      </p>
    </div>

    <!-- Submit -->
    <div style="display: flex; gap: 12px; justify-content: flex-end;">
      <a href="/reception/reservations" 
        style="padding: 12px 28px; background: #f5f5f5; color: #555; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem;">
        Huy
      </a>
      <button type="submit" id="submitBtn"
        style="padding: 12px 32px; background: #00897b; color: white; border: none; border-radius: 8px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: background 0.2s;">
        Xac Nhan Dat Ban Ho Khach
      </button>
    </div>
  </form>
</div>

<script>
const DEPOSIT = 100000;
const qtyInputs = document.querySelectorAll('.qty-input');

// Dish search & filter
const dishSearch = document.getElementById('dishSearch');
const catBtns = document.querySelectorAll('.cat-btn');
const dishCards = document.querySelectorAll('.dish-card');
let activeCat = 'all';

dishSearch.addEventListener('input', filterDishes);
catBtns.forEach(btn => {
  btn.addEventListener('click', function() {
    catBtns.forEach(b => {
      b.style.background = 'white'; b.style.color = '#555'; b.style.borderColor = '#b2dfdb';
      b.classList.remove('active-cat');
    });
    this.style.background = '#00897b'; this.style.color = 'white'; this.style.borderColor = '#00897b';
    this.classList.add('active-cat');
    activeCat = this.dataset.cat;
    filterDishes();
  });
});

function filterDishes() {
  const term = dishSearch.value.toLowerCase();
  dishCards.forEach(card => {
    const matchSearch = card.dataset.name.includes(term);
    const matchCat = activeCat === 'all' || card.dataset.cat === activeCat;
    card.style.display = (matchSearch && matchCat) ? 'block' : 'none';
  });
}

// Qty buttons
document.querySelectorAll('.qty-plus').forEach(btn => {
  btn.addEventListener('click', function() {
    const input = document.getElementById('qty-' + this.dataset.id);
    input.value = Math.min(parseInt(input.value || 0) + 1, 50);
    input.dispatchEvent(new Event('change'));
  });
});
document.querySelectorAll('.qty-minus').forEach(btn => {
  btn.addEventListener('click', function() {
    const input = document.getElementById('qty-' + this.dataset.id);
    input.value = Math.max(parseInt(input.value || 0) - 1, 0);
    input.dispatchEvent(new Event('change'));
  });
});

// Update summary
qtyInputs.forEach(input => input.addEventListener('change', updateSummary));

function updateSummary() {
  let foodRaw = 0, foodDiscount = 0;
  let selectedHtml = '<ul style="list-style:none;padding:0;margin:0;">';
  let hasItems = false;

  qtyInputs.forEach(input => {
    const qty = parseInt(input.value) || 0;
    if (qty > 0) {
      hasItems = true;
      const price = parseFloat(input.dataset.price);
      const disc = parseFloat(input.dataset.discount) || 0;
      const itemRaw = price * qty;
      const itemDisc = (disc / 100) * itemRaw;
      foodRaw += itemRaw;
      foodDiscount += itemDisc;
      selectedHtml += `<li style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #b2dfdb;font-size:0.88rem;">
        <span>${input.dataset.name} x${qty}</span>
        <span style="font-weight:600;color:#00695c;">${(itemRaw - itemDisc).toLocaleString('vi-VN')}d</span>
      </li>`;
    }
  });
  selectedHtml += '</ul>';

  const foodNet = foodRaw - foodDiscount;
  const grand = DEPOSIT + foodNet;

  document.getElementById('selectedItems').innerHTML = hasItems ? selectedHtml : '<p style="color:#aaa;font-size:0.85rem;margin:0;">Chua chon mon an nao.</p>';
  document.getElementById('foodTotalRow').style.display = hasItems ? 'flex' : 'none';
  document.getElementById('discountRow').style.display = (hasItems && foodDiscount > 0) ? 'flex' : 'none';
  document.getElementById('foodTotalSpan').textContent = foodRaw.toLocaleString('vi-VN') + 'd';
  document.getElementById('discountSpan').textContent = '-' + foodDiscount.toLocaleString('vi-VN') + 'd';
  document.getElementById('grandTotal').textContent = grand.toLocaleString('vi-VN') + 'd';
}

// Time validation — 2 hours minimum
function checkTime() {
  const date = document.getElementById('reservDate').value;
  const time = document.getElementById('reservTime').value;
  const warning = document.getElementById('timeWarning');
  if (!date || !time) { warning.style.display = 'none'; return true; }
  const reservDT = new Date(date + 'T' + time);
  const twoHoursLater = new Date(Date.now() + 2 * 60 * 60 * 1000);
  if (reservDT < twoHoursLater) {
    warning.style.display = 'block';
    document.getElementById('reservDate').style.borderColor = '#c62828';
    document.getElementById('reservTime').style.borderColor = '#c62828';
    return false;
  }
  warning.style.display = 'none';
  document.getElementById('reservDate').style.borderColor = '#00897b';
  document.getElementById('reservTime').style.borderColor = '#00897b';
  return true;
}

document.getElementById('reservDate').addEventListener('change', checkTime);
document.getElementById('reservTime').addEventListener('change', checkTime);

document.getElementById('guestReservationForm').addEventListener('submit', function(e) {
  if (!checkTime()) {
    e.preventDefault();
    alert('Thoi gian dat ban phai cach hien tai it nhat 2 tieng. Vui long chon lai.');
  }
});

// Init
updateSummary();
</script>
