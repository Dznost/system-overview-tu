<!-- SEO Meta for Admin Pages -->
<section class="admin-form-page">
    <div class="form-container">
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/admin">Dashboard</a></li>
                <li><a href="/admin/products">Quan Ly San Pham</a></li>
                <li aria-current="page"><%= product ? 'Chinh Sua' : 'Them Moi' %></li>
            </ol>
        </nav>

        <!-- Page Header -->
        <header class="page-header">
            <div class="header-content">
                <div class="header-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="9" y1="9" x2="15" y2="9"></line>
                        <line x1="9" y1="15" x2="15" y2="15"></line>
                    </svg>
                </div>
                <div class="header-text">
                    <h1><%= product ? 'Chinh Sua San Pham' : 'Them San Pham Moi' %></h1>
                    <p class="header-description">Quan ly thong tin chi tiet va hang ton cua san pham ban</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="/admin/products" class="btn btn-ghost">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Quay Lai
                </a>
            </div>
        </header>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" role="alert">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                <span><%= error %></span>
            </div>
        <% } %>
        
        <form method="POST" action="<%= product ? '/admin/products/' + product._id : '/admin/products' %>" class="modern-form" id="productForm">
            <div class="form-layout">
                <!-- Main Content Column -->
                <div class="form-main">
                    <!-- Basic Information Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Thong Tin Co Ban</h2>
                            <span class="card-badge">Bat Buoc</span>
                        </div>
                        <div class="card-body">
                            <div class="field-group">
                                <label for="name" class="field-label">
                                    Ten San Pham
                                    <span class="required" aria-label="Bat buoc">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="name" 
                                    name="name" 
                                    value="<%= product?.name || '' %>" 
                                    placeholder="Vi du: Tran Trau, Nuoc Chanh"
                                    required 
                                    class="field-input"
                                    autocomplete="off"
                                >
                                <span class="field-hint">Ten se hien thi tren trang chu va menu san pham</span>
                            </div>

                            <div class="field-group">
                                <label for="description" class="field-label">
                                    Mo Ta Chi Tiet
                                    <span class="required" aria-label="Bat buoc">*</span>
                                </label>
                                <textarea 
                                    id="description" 
                                    name="description" 
                                    rows="4" 
                                    placeholder="Mo ta chi tiet san pham..."
                                    required 
                                    class="field-textarea"
                                ><%= product?.description || '' %></textarea>
                                <span class="field-hint">Mo ta chi tiet giup khach hang hieu ro hon ve san pham</span>
                            </div>

                            <div class="field-row">
                                <div class="field-group">
                                    <label for="productType" class="field-label">
                                        Loai San Pham
                                        <span class="required" aria-label="Bat buoc">*</span>
                                    </label>
                                    <div class="select-wrapper">
                                        <select id="productType" name="productType" required class="field-select">
                                            <option value="">-- Chon Loai San Pham --</option>
                                            <option value="beverage" <%= product?.productType === 'beverage' ? 'selected' : '' %>>Do Uong</option>
                                            <option value="snack" <%= product?.productType === 'snack' ? 'selected' : '' %>>Do An Nhe</option>
                                            <option value="merchandise" <%= product?.productType === 'merchandise' ? 'selected' : '' %>>Hang Hoa</option>
                                            <option value="other" <%= product?.productType === 'other' ? 'selected' : '' %>>Khac</option>
                                        </select>
                                        <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="6 9 12 15 18 9"/>
                                        </svg>
                                    </div>
                                </div>

                                <div class="field-group">
                                    <label for="price" class="field-label">
                                        Gia Ban (VND)
                                        <span class="required" aria-label="Bat buoc">*</span>
                                    </label>
                                    <div class="input-with-addon">
                                        <input 
                                            type="number" 
                                            id="price" 
                                            name="price" 
                                            value="<%= product?.price || '' %>" 
                                            placeholder="0"
                                            min="0" 
                                            step="1000" 
                                            required 
                                            class="field-input"
                                        >
                                        <span class="input-addon">VND</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Image Section Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Hinh Anh San Pham</h2>
                        </div>
                        <div class="card-body">
                            <div class="field-group">
                                <label for="image" class="field-label">
                                    URL Hinh Anh
                                    <span class="required" aria-label="Bat buoc">*</span>
                                </label>
                                <input 
                                    type="url" 
                                    id="image" 
                                    name="image" 
                                    value="<%= product?.image || '' %>" 
                                    placeholder="https://example.com/hinh-san-pham.jpg"
                                    required 
                                    class="field-input"
                                    onchange="previewProductImage(this.value)"
                                >
                                <span class="field-hint">Su dung hinh anh chat luong cao</span>
                            </div>

                            <div class="image-preview-container" id="productImagePreview">
                                <% if (product?.image) { %>
                                    <img src="<%= product.image %>" alt="<%= product.name %>" 
                                         onerror="this.parentElement.innerHTML='<div class=\'preview-placeholder\'><svg width=\'48\' height=\'48\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.5\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'M21 15l-5-5L5 21\'/></svg><span>Khong the tai hinh anh</span></div>'">
                                <% } else { %>
                                    <div class="preview-placeholder">
                                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                            <path d="M21 15l-5-5L5 21"/>
                                        </svg>
                                        <span>Hinh anh se hien thi o day</span>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar Column -->
                <div class="form-sidebar">
                    <!-- Promotion Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Khuyen Mai</h2>
                            <span class="card-badge secondary">Tuy Chon</span>
                        </div>
                        <div class="card-body">
                            <div class="field-group">
                                <label for="discount" class="field-label">Chiet Khau (%)</label>
                                <div class="input-with-addon">
                                    <input 
                                        type="number" 
                                        id="discount" 
                                        name="discount" 
                                        value="<%= product?.discount || 0 %>" 
                                        placeholder="0"
                                        min="0" 
                                        max="100" 
                                        class="field-input"
                                    >
                                    <span class="input-addon">%</span>
                                </div>
                                <span class="field-hint">Nhap 0 neu khong giam gia</span>
                            </div>

                            <div class="field-group">
                                <label for="event" class="field-label">Su Kien Ap Dung</label>
                                <div class="select-wrapper">
                                    <select id="event" name="event" class="field-select">
                                        <option value="">-- Khong ap dung --</option>
                                        <% if (events && events.length > 0) { %>
                                            <% events.forEach(event => { %>
                                                <option value="<%= event._id %>" <%= product?.event && product.event._id.toString() === event._id.toString() ? 'selected' : '' %>>
                                                    <%= event.title %> (<%= event.discount %>%)
                                                </option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                    <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6 9 12 15 18 9"/>
                                    </svg>
                                </div>
                                <span class="field-hint">Giam gia su kien se ghi de giam gia co ban</span>
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Quan Ly Hang Ton</h2>
                            <span class="card-badge">Moi</span>
                        </div>
                        <div class="card-body">
                            <div class="field-group">
                                <label for="quantity" class="field-label">
                                    So Luong Tong Cong
                                </label>
                                <div class="input-with-addon">
                                    <input 
                                        type="number" 
                                        id="quantity" 
                                        name="quantity" 
                                        value="<%= product?.quantity || 0 %>" 
                                        placeholder="0"
                                        min="0" 
                                        step="1" 
                                        class="field-input"
                                    >
                                    <span class="input-addon">Cai</span>
                                </div>
                                <span class="field-hint">So luong = 0 thi van hien thi nhung danh dau la Chay Hang</span>
                            </div>

                            <% if (product) { %>
                                <div class="field-group">
                                    <label class="field-label">Lich Su Dat Hang</label>
                                    <div style="background: #f9fafb; padding: 12px 16px; border-radius: 8px; border: 1px solid #e5e7eb;">
                                        <div style="font-size: 0.95rem; color: #1f2937;">
                                            <strong><%= product.totalOrdersCompleted || 0 %></strong>
                                            <span style="color: #6b7280;">lan dat hang thanh cong</span>
                                        </div>
                                        <% if (product.isBestSelling) { %>
                                            <div style="margin-top: 8px; font-size: 0.9rem; color: #92400e; background: #fef3c7; padding: 6px 8px; border-radius: 4px; display: inline-block;">
                                                Status: Ban chay tren thi truong (tu: <%= new Date(product.bestSellingPromotedAt).toLocaleDateString('vi-VN') %>)
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>

                            <% if (branches && branches.length > 0) { %>
                                <div class="field-group">
                                    <label class="field-label">Chi Nhanh Cung Cap San Pham</label>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                        <% branches.forEach(branch => { %>
                                            <% const isBranchSelected = product && product.branchInventory && product.branchInventory.some(inv => inv.branchId && inv.branchId._id && inv.branchId._id.toString() === branch._id.toString()); %>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <input 
                                                    type="checkbox" 
                                                    id="branch_<%= branch._id %>" 
                                                    name="branchIds" 
                                                    value="<%= branch._id %>"
                                                    <%= isBranchSelected ? 'checked' : '' %>
                                                    style="width: 18px; height: 18px; cursor: pointer;">
                                                <label for="branch_<%= branch._id %>" style="cursor: pointer; margin: 0; font-size: 0.9rem;">
                                                    <%= branch.name %>
                                                </label>
                                            </div>
                                        <% }); %>
                                    </div>
                                    <span class="field-hint">Chon chi nhanh co cung cap san pham nay</span>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Status Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Trang Thai</h2>
                        </div>
                        <div class="card-body">
                            <div class="status-indicator">
                                <div class="status-dot <%= product ? 'active' : 'new' %>"></div>
                                <span><%= product ? 'Dang hoat dong' : 'San pham moi' %></span>
                            </div>
                            <% if (product) { %>
                                <div class="meta-info">
                                    <div class="meta-item">
                                        <span class="meta-label">Tao luc:</span>
                                        <span class="meta-value"><%= product.createdAt ? new Date(product.createdAt).toLocaleDateString('vi-VN') : 'N/A' %></span>
                                    </div>
                                    <div class="meta-item">
                                        <span class="meta-label">Cap nhat:</span>
                                        <span class="meta-value"><%= product.updatedAt ? new Date(product.updatedAt).toLocaleDateString('vi-VN') : 'N/A' %></span>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Actions Card -->
                    <div class="form-card actions-card">
                        <button type="submit" class="btn btn-primary btn-full">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/>
                                <polyline points="7 3 7 8 15 8"/>
                            </svg>
                            <%= product ? 'Cap Nhat San Pham' : 'Them San Pham' %>
                        </button>
                        <a href="/admin/products" class="btn btn-secondary btn-full">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                            Huy Bo
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<script>
function previewProductImage(url) {
    const preview = document.getElementById('productImagePreview');
    if (!url) {
        preview.innerHTML = '<div class="preview-placeholder"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span>Hinh anh se hien thi o day</span></div>';
        return;
    }
    const img = new Image();
    img.onload = () => {
        preview.innerHTML = '';
        preview.appendChild(img);
    };
    img.onerror = () => {
        preview.innerHTML = '<div class="preview-placeholder"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span>Khong the tai hinh anh</span></div>';
    };
    img.src = url;
}
</script>
