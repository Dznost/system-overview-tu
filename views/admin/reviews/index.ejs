<div class="admin-layout">
  <div class="container py-6">
    <h1 class="text-3xl font-bold mb-6">Quản Lý Đánh Giá Sản Phẩm</h1>

    <% if (reviews && reviews.length > 0) { %>
      <div class="space-y-4">
        <% reviews.forEach(review => { %>
          <div class="review-card card p-4 border rounded">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <strong><%= review.userId ? review.userId.name || 'Khách Hàng' : 'Ẩn Danh' %></strong>
                  <span class="text-sm text-gray-500">
                    <%= new Date(review.createdAt).toLocaleDateString('vi-VN') %>
                  </span>
                  <% if (review.verifiedPurchase) { %>
                    <span class="badge badge-success text-xs">Đã Mua</span>
                  <% } %>
                </div>

                <div class="stars mb-2">
                  <% for (let i = 0; i < 5; i++) { %>
                    <span class="text-yellow-400"><%= i < review.rating ? '★' : '☆' %></span>
                  <% } %>
                  <span class="ml-2"><strong><%= review.rating %>/5</strong></span>
                </div>

                <% if (review.productId) { %>
                  <p class="text-sm text-gray-600">Sản Phẩm: <strong><%= review.productId.name %></strong></p>
                <% } %>
                <% if (review.dishId) { %>
                  <p class="text-sm text-gray-600">Món Ăn: <strong><%= review.dishId.name %></strong></p>
                <% } %>

                <% if (review.orderId) { %>
                  <p class="text-sm text-gray-600">Đơn hàng: <strong><%= review.orderId.orderCode || '#' + review.orderId._id.toString().slice(-8).toUpperCase() %></strong> · <%= review.orderId.status %></p>
                <% } %>

                <div class="review-content mt-2 p-3 bg-gray-50 rounded">
                  <p><%= review.comment %></p>
                </div>

                <% if (review.messages && review.messages.length) { %>
                  <div class="admin-thread">
                    <% review.messages.forEach(message => { %>
                      <div class="admin-message <%= message.senderRole === 'admin' ? 'from-admin' : '' %>">
                        <strong><%= message.senderName %></strong>
                        <small><%= new Date(message.createdAt).toLocaleString('vi-VN') %></small>
                        <p><%= message.content %></p>
</div>
<style>
.admin-thread{display:flex;flex-direction:column;gap:10px;margin-top:14px}.admin-message{max-width:75%;padding:12px;border-radius:10px;background:#f4f1ec}.admin-message.from-admin{margin-left:auto;background:#eee4d5}.admin-message small{display:block;color:#6b7280;margin-top:3px}.admin-message p{margin:7px 0 0}.admin-reply-form{display:flex;flex-direction:column;gap:8px;margin-top:12px}.admin-reply-form textarea{min-height:76px;border:1px solid #d5cec3;border-radius:8px;padding:10px;font:inherit}.admin-reply-form button{align-self:flex-start}
</style>

                    <% }) %>
                  </div>
                  <form method="POST" action="/admin/reviews/<%= review._id %>/reply" class="admin-reply-form">
                    <label for="reply-<%= review._id %>">Phản hồi khách hàng</label>
                    <textarea id="reply-<%= review._id %>" name="content" maxlength="1000" required></textarea>
                    <button type="submit" class="btn btn-primary">Gửi phản hồi</button>
                  </form>
                <% } %>

                <% if (review.status === 'pending') { %>
                  <div class="mt-3 flex gap-2">
                    <form method="POST" action="/admin/reviews/<%= review._id %>/approve" style="display: inline;">
                      <button type="submit" class="btn btn-sm btn-success">Duyệt</button>
                    </form>
                    <form method="POST" action="/admin/reviews/<%= review._id %>/reject" style="display: inline;">
                      <button type="submit" class="btn btn-sm btn-danger">Từ Chối</button>
                    </form>
                  </div>
                <% } else { %>
                  <div class="mt-2">
                    <span class="badge <%= review.status === 'approved' ? 'badge-success' : 'badge-danger' %>">
                      <%= review.status === 'approved' ? 'Đã Duyệt' : 'Đã Từ Chối' %>
                    </span>
                  </div>
                <% } %>
              </div>

              <form method="POST" action="/admin/reviews/<%= review._id %>/delete" style="display: inline;" onsubmit="return confirm('Xóa đánh giá này?');">
                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="alert alert-info">Chưa có đánh giá nào.</div>
    <% } %>
  </div>
</div>
