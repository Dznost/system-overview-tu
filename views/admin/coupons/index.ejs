<div class="admin-layout">
  <div class="container py-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold">Quản Lý Mã Giảm Giá</h1>
      <a href="/admin/coupons/new" class="btn btn-primary">+ Thêm Mã Mới</a>
    </div>

    <% if (coupons && coupons.length > 0) { %>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Mã Giảm Giá</th>
              <th>Kiểu Giảm</th>
              <th>Giá Trị</th>
              <th>Lượt Sử Dụng</th>
              <th>Hạn Sử Dụng</th>
              <th>Trạng Thái</th>
              <th>Hành Động</th>
            </tr>
          </thead>
          <tbody>
            <% coupons.forEach(coupon => { %>
              <tr>
                <td><strong><%= coupon.code %></strong></td>
                <td>
                  <% if (coupon.discountType === 'percentage') { %>
                    Phần Trăm
                  <% } else { %>
                    Cố Định (₫)
                  <% } %>
                </td>
                <td>
                  <% if (coupon.discountType === 'percentage') { %>
                    <%= coupon.discountValue %>%
                  <% } else { %>
                    ₫<%= coupon.discountValue.toLocaleString() %>
                  <% } %>
                </td>
                <td><%= coupon.usedCount || 0 %>/<%= coupon.maxUses %></td>
                <td><%= new Date(coupon.validUntil).toLocaleDateString('vi-VN') %></td>
                <td>
                  <% if (new Date() > new Date(coupon.validUntil)) { %>
                    <span class="badge badge-danger">Hết Hạn</span>
                  <% } else if (coupon.usageCount >= coupon.maxUses) { %>
                    <span class="badge badge-warning">Hết Lượt</span>
                  <% } else { %>
                    <span class="badge badge-success">Hoạt Động</span>
                  <% } %>
                </td>
                <td>
                  <div class="action-buttons">
                    <a href="/admin/coupons/<%= coupon._id %>/edit" class="btn-sm btn-edit">Sửa</a>
                    <form method="POST" action="/admin/coupons/<%= coupon._id %>/delete" style="display: inline;" onsubmit="return confirm('Xác nhận xóa?');">
                      <button type="submit" class="btn-sm btn-danger">Xóa</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info">Chưa có mã giảm giá nào. <a href="/admin/coupons/new">Tạo mã mới</a></div>
    <% } %>
  </div>
</div>
