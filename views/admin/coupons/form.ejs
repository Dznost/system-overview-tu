<section class="admin-form-page">
    <div class="form-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/admin">Dashboard</a></li>
                <li><a href="/admin/coupons">Ma Giam Gia</a></li>
                <li aria-current="page"><%= coupon ? 'Chinh Sua' : 'Them Moi' %></li>
            </ol>
        </nav>

        <header class="page-header">
            <div class="header-content">
                <div class="header-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16v16H4z"/><path d="M9 9h6v6H9z"/>
                    </svg>
                </div>
                <div class="header-text">
                    <h1><%= coupon ? 'Chinh Sua Ma Giam Gia' : 'Them Ma Giam Gia Moi' %></h1>
                    <p class="header-description">Quan ly ma khuyuen mai va dieu kien su dung</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="/admin/coupons" class="btn btn-ghost">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Quay Lai
                </a>
            </div>
        </header>

        <form method="POST" action="<%= coupon ? '/admin/coupons/' + coupon._id : '/admin/coupons' %>" class="modern-form">
            <div class="form-layout">
                <div class="form-main">
                    <!-- Ma Giam Gia Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Thong Tin Co Ban</h2>
                            <span class="card-badge">Bat Buoc</span>
                        </div>
                        <div class="card-body">
                            <div class="field-group">
                                <label for="code" class="field-label">
                                    Ma Giam Gia <span class="required">*</span>
                                </label>
                                <input type="text" id="code" name="code" required 
                                    value="<%= coupon ? coupon.code : '' %>" 
                                    placeholder="VD: SUMMER2024" maxlength="50" 
                                    class="field-input" style="text-transform: uppercase;">
                                <span class="field-hint">Chi dung chu in hoa va so</span>
                            </div>

                            <div class="field-row">
                                <div class="field-group">
                                    <label for="discountType" class="field-label">
                                        Loai Giam <span class="required">*</span>
                                    </label>
                                    <div class="select-wrapper">
                                        <select id="discountType" name="discountType" required class="field-select" onchange="updateDiscountLabel()">
                                            <option value="">-- Chon --</option>
                                            <option value="percentage" <%= coupon && coupon.discountType === 'percentage' ? 'selected' : '' %>>Phan Tram (%)</option>
                                            <option value="fixed_amount" <%= coupon && coupon.discountType === 'fixed_amount' ? 'selected' : '' %>>Co Dinh (d)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="field-group">
                                    <label for="discountValue" class="field-label">
                                        Gia Tri <span id="discountLabel">Giam</span> <span class="required">*</span>
                                    </label>
                                    <input type="number" id="discountValue" name="discountValue" required 
                                        value="<%= coupon ? coupon.discountValue : '' %>" min="0" class="field-input">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Thoi Han Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Thoi Han Su Dung</h2>
                            <span class="card-badge">Bat Buoc</span>
                        </div>
                        <div class="card-body">
                            <div class="field-row">
                                <div class="field-group">
                                    <label for="validFrom" class="field-label">
                                        Ngay Bat Dau <span class="required">*</span>
                                    </label>
                                    <input type="datetime-local" id="validFrom" name="validFrom" required 
                                        value="<%= coupon ? new Date(coupon.validFrom).toISOString().slice(0, 16) : '' %>" 
                                        class="field-input">
                                </div>

                                <div class="field-group">
                                    <label for="validUntil" class="field-label">
                                        Ngay Ket Thuc <span class="required">*</span>
                                    </label>
                                    <input type="datetime-local" id="validUntil" name="validUntil" required 
                                        value="<%= coupon ? new Date(coupon.validUntil).toISOString().slice(0, 16) : '' %>" 
                                        class="field-input">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dieu Kien Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2>Dieu Kien Su Dung</h2>
                        </div>
                        <div class="card-body">
                            <div class="field-group">
                                <label for="maxUses" class="field-label">
                                    So Luot Su Dung Toi Da <span class="required">*</span>
                                </label>
                                <input type="number" id="maxUses" name="maxUses" required 
                                    value="<%= coupon ? coupon.maxUses : '' %>" min="1" class="field-input">
                                <span class="field-hint">So luong coupon co the su dung trong tong</span>
                            </div>

                            <div class="field-group">
                                <label for="minOrderValue" class="field-label">
                                    Gia Tri Don Toi Thieu (d)
                                </label>
                                <input type="number" id="minOrderValue" name="minOrderValue" 
                                    value="<%= coupon ? coupon.minOrderValue || '' : '' %>" min="0" class="field-input">
                                <span class="field-hint">De trong neu khong co dieu kien toi thieu</span>
                            </div>

                            <div class="field-group">
                                <label for="applicableTo" class="field-label">
                                    Ap Dung Cho
                                </label>
                                <textarea id="applicableTo" name="applicableTo" rows="3" 
                                    placeholder="all (tat ca) / dish (mon an) / product (san pham)" 
                                    class="field-textarea"><%= coupon && coupon.applicableTo ? coupon.applicableTo.join(', ') : '' %></textarea>
                                <span class="field-hint">De trong de ap dung cho tat ca san pham</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar Info -->
                <aside class="form-sidebar">
                    <div class="sidebar-card">
                        <h3>Thong Tin</h3>
                        <ul class="info-list">
                            <li><strong>Ma Giam Gia:</strong> <span class="code"><%= coupon ? coupon.code : '...' %></span></li>
                            <li><strong>Trang Thai:</strong> <span class="status-badge"><%= coupon && coupon.isActive ? 'Hoat Dong' : 'Ngung' %></span></li>
                            <% if (coupon) { %>
                            <li><strong>Da Su Dung:</strong> <span><%= coupon.usedCount || 0 %> / <%= coupon.maxUses %></span></li>
                            <% } %>
                        </ul>
                    </div>
                </aside>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">Luu</button>
                <a href="/admin/coupons" class="btn btn-secondary btn-lg">Huy</a>
            </div>
        </form>
    </div>
</section>

<style>
.status-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    background: #e8f5e9;
    color: #2e7d32;
}
.code {
    font-family: monospace;
    background: #f5f5f5;
    padding: 2px 6px;
    border-radius: 3px;
}
</style>

<script>
function updateDiscountLabel() {
  const type = document.getElementById('discountType').value;
  document.getElementById('discountLabel').textContent = type === 'percentage' ? 'Tỷ Lệ (%)' : 'Số Tiền (₫)';
}
document.addEventListener('DOMContentLoaded', updateDiscountLabel);
</script>
